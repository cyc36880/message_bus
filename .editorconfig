# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4
max_line_length = 100

[*.{c,h}]
indent_size = 4

[*.{cmake,txt}]
indent_size = 4

[CMakeLists.txt]
indent_size = 4

[*.{md,markdown}]
indent_size = 2
trim_trailing_whitespace = false

[*.{json,yml,yaml}]
indent_size = 2

[*.md]
max_line_length = off

[Makefile]
indent_style = tab
